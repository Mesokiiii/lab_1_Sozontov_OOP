<Window x:Class="WpfLabApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:WpfLabApp.Views"
        mc:Ignorable="d"
        Title="Лабораторная работа №1 - Элементы подсистемы WPF"
        Height="850" Width="1200"
        MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Banner -->
        <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" Padding="20,14" BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Лабораторная работа №1" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Исследование базовых элементов подсистемы WPF и контейнеров компоновки" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#1E1B4B" CornerRadius="6" Padding="10,6" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" VerticalAlignment="Center">
                    <TextBlock Text="WPF • .NET 8 • C#" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main TabControl -->
        <TabControl Grid.Row="1" Margin="16" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="18,10"/>
                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                    <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDefault}"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Margin" Value="0,0,4,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,1,1,0" CornerRadius="8,8,0,0" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                            <Condition Property="IsSelected" Value="False"/>
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="Border" Property="Background" Value="{StaticResource BgCardHoverBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- 1.1 Основное -->
            <TabItem Header="1.1. Основное">
                <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="1" CornerRadius="0,8,8,8" Padding="10">
                    <views:MainTabView />
                </Border>
            </TabItem>

            <!-- 1.2 Цветовая палитра -->
            <TabItem Header="1.2. Цветовая палитра">
                <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="1" CornerRadius="0,8,8,8" Padding="10">
                    <views:ColorPaletteTabView />
                </Border>
            </TabItem>

            <!-- 1.3 Элементы управления -->
            <TabItem Header="1.3. Элементы управления">
                <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="1" CornerRadius="0,8,8,8" Padding="10">
                    <views:ControlsTabView />
                </Border>
            </TabItem>

            <!-- 1.4 Контейнеры компоновки -->
            <TabItem Header="1.4. Контейнеры компоновки">
                <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="1" CornerRadius="0,8,8,8" Padding="10">
                    <views:LayoutContainersTabView />
                </Border>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid>
                <TextBlock Text="Готово • Выберите вкладку для перехода к элементам лабораторной работы" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                <TextBlock HorizontalAlignment="Right" Text="Статус: Все модули подключены" Foreground="{StaticResource SuccessBrush}" FontSize="12" FontWeight="SemiBold"/>
            </Grid>
        </Border>
    </Grid>
</Window>
