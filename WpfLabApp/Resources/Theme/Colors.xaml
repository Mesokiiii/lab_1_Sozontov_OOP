<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ======================================================== -->
    <!-- Enterprise Design System: Foundation Color Tokens        -->
    <!-- WCAG AA Compliant High-Contrast Slate Dark Theme         -->
    <!-- ======================================================== -->

    <!-- Base Canvas & Surface Colors -->
    <Color x:Key="BgDark">#0F172A</Color>
    <Color x:Key="BgCardDark">#1E293B</Color>
    <Color x:Key="BgCardHoverDark">#334155</Color>
    <Color x:Key="BorderDark">#334155</Color>
    <Color x:Key="TextPrimaryDark">#F8FAFC</Color>
    <Color x:Key="TextSecondaryDark">#94A3B8</Color>
    <Color x:Key="TextMutedDark">#64748B</Color>

    <!-- Brand & Indicator Colors (task.txt п. 1.2.2) -->
    <Color x:Key="PrimaryColor">#3B82F6</Color>
    <Color x:Key="PrimaryHoverColor">#2563EB</Color>
    <Color x:Key="AccentColor">#8B5CF6</Color>
    <Color x:Key="AccentHoverColor">#7C3AED</Color>
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="SuccessHoverColor">#059669</Color>
    <Color x:Key="ErrorColor">#EF4444</Color>
    <Color x:Key="ErrorHoverColor">#DC2626</Color>
    <Color x:Key="InfoColor">#06B6D4</Color>
    <Color x:Key="InfoHoverColor">#0891B2</Color>

    <!-- Frozen SolidColorBrushes for Optimal GPU Rendering -->
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgDark}"/>
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardDark}"/>
    <SolidColorBrush x:Key="BgCardHoverBrush" Color="{StaticResource BgCardHoverDark}"/>
    <SolidColorBrush x:Key="BorderBrushDefault" Color="{StaticResource BorderDark}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryDark}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryDark}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedDark}"/>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessHoverBrush" Color="{StaticResource SuccessHoverColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="ErrorHoverBrush" Color="{StaticResource ErrorHoverColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="InfoHoverBrush" Color="{StaticResource InfoHoverColor}"/>
</ResourceDictionary>
