        <!-- Warning Accent Colors -->
        <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="WarningHoverBrush" Color="#D97706"/>

        <!-- ========================================================================= -->
        <!-- MODERN EXPANDER TEMPLATE                                                  -->
        <!-- ========================================================================= -->
        <Style x:Key="SectionExpanderStyle" TargetType="Expander">
            <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <DockPanel>
                                <ToggleButton x:Name="HeaderSite"
                                              DockPanel.Dock="Top"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              Cursor="Hand"
                                              Focusable="False">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="HeaderBorder" Background="Transparent" Padding="16,14" CornerRadius="8,8,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter Grid.Column="0" ContentSource="Content" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" x:Name="ArrowBox" Background="#334155" Width="28" Height="28" CornerRadius="14" Margin="12,0,0,0">
                                                        <Path x:Name="Arrow" Data="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z" 
                                                              Fill="{StaticResource TextSecondaryBrush}" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              RenderTransformOrigin="0.5,0.5">
                                                            <Path.RenderTransform>
                                                                <RotateTransform Angle="0"/>
                                                            </Path.RenderTransform>
                                                        </Path>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HeaderBorder" Property="Background" Value="#24334A"/>
                                                    <Setter TargetName="Arrow" Property="Fill" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Arrow" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="180"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter TargetName="ArrowBox" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                    <Setter TargetName="Arrow" Property="Fill" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Border x:Name="Separator" DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderBrushDefault}" Visibility="Collapsed"/>
                                <ContentPresenter x:Name="ExpandSite" DockPanel.Dock="Bottom" ContentSource="Content" Margin="{TemplateBinding Padding}" Visibility="Collapsed"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Separator" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========================================================================= -->
        <!-- BUTTON TEMPLATES & STYLES (SOLID & OUTLINED)                              -->
        <!-- ========================================================================= -->
        <ControlTemplate x:Key="SolidButtonTemplate" TargetType="Button">
            <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="btnBorder" Property="Opacity" Value="0.88"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="btnBorder" Property="Opacity" Value="0.75"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="btnBorder" Property="Opacity" Value="0.45"/>
                    <Setter TargetName="btnBorder" Property="Background" Value="#334155"/>
                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#475569"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template" Value="{StaticResource SolidButtonTemplate}"/>
        </Style>

        <Style x:Key="BtnAccent" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>

        <Style x:Key="BtnSuccess" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
        </Style>

        <Style x:Key="BtnError" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="{StaticResource ErrorBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
        </Style>

        <Style x:Key="BtnInfo" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InfoBrush}"/>
        </Style>

        <!-- Outlined Button Template -->
        <ControlTemplate x:Key="OutlinedButtonTemplate" TargetType="Button">
            <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="btnBorder" Property="Background" Value="#1A3B82F6"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="btnBorder" Property="Background" Value="#333B82F6"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="btnBorder" Property="Opacity" Value="0.4"/>
                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#475569"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="BtnOutlinedPrimary" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template" Value="{StaticResource OutlinedButtonTemplate}"/>
        </Style>

        <Style x:Key="BtnOutlinedAccent" TargetType="Button" BasedOn="{StaticResource BtnOutlinedPrimary}">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>

        <Style x:Key="BtnOutlinedSuccess" TargetType="Button" BasedOn="{StaticResource BtnOutlinedPrimary}">
            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
        </Style>

        <Style x:Key="BtnOutlinedError" TargetType="Button" BasedOn="{StaticResource BtnOutlinedPrimary}">
            <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
        </Style>

        <Style x:Key="BtnOutlinedInfo" TargetType="Button" BasedOn="{StaticResource BtnOutlinedPrimary}">
            <Setter Property="BorderBrush" Value="{StaticResource InfoBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource InfoBrush}"/>
        </Style>

        <!-- ========================================================================= -->
        <!-- TOGGLE BUTTON (SWITCH) STYLES ACROSS PALETTE COLORS                       -->
        <!-- ========================================================================= -->
        <ControlTemplate x:Key="ModernToggleSwitchTemplate" TargetType="ToggleButton">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="SwitchTrack" Width="44" Height="24" CornerRadius="12" Background="#334155" BorderBrush="#475569" BorderThickness="1">
                    <Grid>
                        <Ellipse x:Name="SwitchThumb" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="4,0,0,0">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                </Border>
                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="SwitchTrack" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=BorderBrush}"/>
                    <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=BorderBrush}"/>
                    <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                    <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,4,0"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="SwitchTrack" Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="SwitchTrack" Property="Opacity" Value="0.4"/>
                    <Setter TargetName="SwitchThumb" Property="Opacity" Value="0.6"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="ModernToggleSwitch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Template" Value="{StaticResource ModernToggleSwitchTemplate}"/>
        </Style>

        <Style x:Key="ModernToggleSwitchAccent" TargetType="ToggleButton" BasedOn="{StaticResource ModernToggleSwitch}">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>

        <Style x:Key="ModernToggleSwitchSuccess" TargetType="ToggleButton" BasedOn="{StaticResource ModernToggleSwitch}">
            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
        </Style>

        <Style x:Key="ModernToggleSwitchError" TargetType="ToggleButton" BasedOn="{StaticResource ModernToggleSwitch}">
            <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
        </Style>

        <Style x:Key="ModernToggleSwitchInfo" TargetType="ToggleButton" BasedOn="{StaticResource ModernToggleSwitch}">
            <Setter Property="BorderBrush" Value="{StaticResource InfoBrush}"/>
        </Style>

        <!-- ========================================================================= -->
        <!-- CHECKBOX STYLES ACROSS PALETTE COLORS                                     -->
        <!-- ========================================================================= -->
        <ControlTemplate x:Key="ModernCheckBoxTemplate" TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="BoxBorder" Width="20" Height="20" CornerRadius="4" Background="#0F172A" BorderBrush="#475569" BorderThickness="1.5">
                    <Grid>
                        <Path x:Name="CheckIcon" Data="{StaticResource GeoCheck}" Fill="White" Stretch="Uniform" Width="12" Height="12" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Rectangle x:Name="IndeterminateMark" Width="10" Height="2.5" Fill="White" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <ContentPresenter Content="{TemplateBinding Content}" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="BoxBorder" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=BorderBrush}"/>
                    <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=BorderBrush}"/>
                    <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="{x:Null}">
                    <Setter TargetName="BoxBorder" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=BorderBrush}"/>
                    <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=BorderBrush}"/>
                    <Setter TargetName="IndeterminateMark" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=BorderBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Template" Value="{StaticResource ModernCheckBoxTemplate}"/>
        </Style>

        <Style x:Key="ModernCheckBoxAccent" TargetType="CheckBox" BasedOn="{StaticResource ModernCheckBox}">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>

        <Style x:Key="ModernCheckBoxSuccess" TargetType="CheckBox" BasedOn="{StaticResource ModernCheckBox}">
            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
        </Style>

        <Style x:Key="ModernCheckBoxError" TargetType="CheckBox" BasedOn="{StaticResource ModernCheckBox}">
            <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
        </Style>

        <Style x:Key="ModernCheckBoxInfo" TargetType="CheckBox" BasedOn="{StaticResource ModernCheckBox}">
            <Setter Property="BorderBrush" Value="{StaticResource InfoBrush}"/>
        </Style>

        <!-- ========================================================================= -->
        <!-- RADIOBUTTON STYLES ACROSS PALETTE COLORS                                  -->
        <!-- ========================================================================= -->
        <ControlTemplate x:Key="ModernRadioButtonTemplate" TargetType="RadioButton">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="20" Height="20">
                    <Ellipse x:Name="OuterCircle" Stroke="#475569" StrokeThickness="1.5" Fill="#0F172A"/>
                    <Ellipse x:Name="InnerDot" Width="8" Height="8" Fill="White" Visibility="Collapsed"/>
                </Grid>
                <ContentPresenter Content="{TemplateBinding Content}" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="OuterCircle" Property="Stroke" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=BorderBrush}"/>
                    <Setter TargetName="OuterCircle" Property="Fill" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=BorderBrush}"/>
                    <Setter TargetName="InnerDot" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="OuterCircle" Property="Stroke" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=BorderBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="ModernRadioButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Template" Value="{StaticResource ModernRadioButtonTemplate}"/>
        </Style>

        <Style x:Key="ModernRadioButtonAccent" TargetType="RadioButton" BasedOn="{StaticResource ModernRadioButton}">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>

        <Style x:Key="ModernRadioButtonSuccess" TargetType="RadioButton" BasedOn="{StaticResource ModernRadioButton}">
            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
        </Style>

        <Style x:Key="ModernRadioButtonError" TargetType="RadioButton" BasedOn="{StaticResource ModernRadioButton}">
            <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
        </Style>

        <Style x:Key="ModernRadioButtonInfo" TargetType="RadioButton" BasedOn="{StaticResource ModernRadioButton}">
            <Setter Property="BorderBrush" Value="{StaticResource InfoBrush}"/>
        </Style>

        <!-- ========================================================================= -->
        <!-- TEXTBOX, PASSWORDBOX, COMBOBOX, LISTBOX STYLES                            -->
        <!-- ========================================================================= -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="txtBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="txtBorder" Property="BorderBrush" Value="#475569"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="txtBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="txtBorder" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="txtBorder" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="txtBorder" Property="Background" Value="#1E293B"/>
                                <Setter TargetName="txtBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="PasswordChar" Value="●"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="pwdBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pwdBorder" Property="BorderBrush" Value="#475569"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="pwdBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="pwdBorder" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="pwdBorder" Property="Background" Value="#1E293B"/>
                                <Setter TargetName="pwdBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="ModernListBox" TargetType="ListBox">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#24334A"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#1E3A8A"/>
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                            <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Main Container -->
    <StackPanel Margin="0,0,0,16">

        <!-- ========================================================================= -->
        <!-- EXPANDER 1: 1.3.1.1. КНОПКИ, ПИКТОГРАММЫ И ПЕРЕКЛЮЧАТЕЛИ                   -->
        <!-- ========================================================================= -->
        <Expander IsExpanded="True" Style="{StaticResource SectionExpanderStyle}" Padding="16">
            <Expander.Header>
                <Grid Margin="4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#1E3A8A" CornerRadius="6" Width="36" Height="36" Margin="0,0,12,0">
                        <Path Data="{StaticResource GeoCheck}" Fill="{StaticResource PrimaryBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="1.3.1.1. Кнопки, пиктограммы и переключатели" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Обычные кнопки (все стили палитры), пиктограммы, ToggleButton, CheckBox и RadioButton" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="#1E293B" BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="1" CornerRadius="12" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock Text="Кнопки и переключатели" FontSize="11" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Expander.Header>

            <StackPanel Margin="4,8">
                <!-- 1. Solid Buttons across all palette colors from 1.2.2 -->
                <TextBlock Text="Обычные кнопки во всех цветовых отображениях из п. 1.2.2 (Solid / Залитые с Hover-эффектами):" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                <WrapPanel Margin="0,0,0,16">
                    <Button Content="Primary" Style="{StaticResource BtnPrimary}" Margin="0,0,10,8" ToolTip="Основная кнопка (Primary)"/>
                    <Button Content="Accent" Style="{StaticResource BtnAccent}" Margin="0,0,10,8" ToolTip="Акцентная кнопка (Accent)"/>
                    <Button Content="Success" Style="{StaticResource BtnSuccess}" Margin="0,0,10,8" ToolTip="Кнопка успешного действия (Success)"/>
                    <Button Content="Error" Style="{StaticResource BtnError}" Margin="0,0,10,8" ToolTip="Кнопка деструктивного действия (Error)"/>
                    <Button Content="Info" Style="{StaticResource BtnInfo}" Margin="0,0,10,8" ToolTip="Информационная кнопка (Info)"/>
                    <Button Content="Disabled" Style="{StaticResource BtnPrimary}" IsEnabled="False" Margin="0,0,10,8" ToolTip="Отключенная кнопка"/>
                </WrapPanel>

                <!-- 2. Outlined Buttons across all palette colors from 1.2.2 -->
                <TextBlock Text="Контурные кнопки (Outlined во всех цветах палитры темы):" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,10"/>
                <WrapPanel Margin="0,0,0,16">
                    <Button Content="Outlined Primary" Style="{StaticResource BtnOutlinedPrimary}" Margin="0,0,10,8" ToolTip="Контурная основная кнопка"/>
                    <Button Content="Outlined Accent" Style="{StaticResource BtnOutlinedAccent}" Margin="0,0,10,8" ToolTip="Контурная акцентная кнопка"/>
                    <Button Content="Outlined Success" Style="{StaticResource BtnOutlinedSuccess}" Margin="0,0,10,8" ToolTip="Контурная кнопка успеха"/>
                    <Button Content="Outlined Error" Style="{StaticResource BtnOutlinedError}" Margin="0,0,10,8" ToolTip="Контурная кнопка ошибки"/>
                    <Button Content="Outlined Info" Style="{StaticResource BtnOutlinedInfo}" Margin="0,0,10,8" ToolTip="Контурная инфо кнопка"/>
                    <Button Content="Outlined Disabled" Style="{StaticResource BtnOutlinedPrimary}" IsEnabled="False" Margin="0,0,10,8" ToolTip="Отключенная контурная кнопка"/>
                </WrapPanel>

                <!-- 3. Icon Buttons (Pictograms) -->
                <TextBlock Text="Пиктограммы (Кнопки с векторными иконками Path):" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,10"/>
                <WrapPanel Margin="0,0,0,12">
                    <!-- Сохранить -->
                    <Button Style="{StaticResource BtnPrimary}" Margin="0,0,10,8" ToolTip="Пиктограмма: Сохранить (Primary)">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoSave}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Сохранить" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Настройки -->
                    <Button Style="{StaticResource BtnAccent}" Margin="0,0,10,8" ToolTip="Пиктограмма: Настройки (Accent)">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoSettings}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Настройки" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Воспроизведение -->
                    <Button Style="{StaticResource BtnSuccess}" Margin="0,0,10,8" ToolTip="Пиктограмма: Запуск (Success)">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoPlay}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Воспроизведение" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Удалить -->
                    <Button Style="{StaticResource BtnError}" Margin="0,0,10,8" ToolTip="Пиктограмма: Удалить (Error)">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoDelete}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Удалить" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Поиск -->
                    <Button Style="{StaticResource BtnInfo}" Margin="0,0,10,8" ToolTip="Пиктограмма: Поиск (Info)">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoSearch}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Поиск" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <!-- Icon-Only Quick Action Buttons across all 5 colors -->
                <TextBlock Text="Быстрые действия (Icon-only круглые кнопки во всех цветах темы):" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Button Style="{StaticResource BtnPrimary}" Width="36" Height="36" Padding="0" Margin="0,0,8,0" ToolTip="Сохранить файл (Primary)">
                        <Path Data="{StaticResource GeoSave}" Fill="White" Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource BtnAccent}" Width="36" Height="36" Padding="0" Margin="0,0,8,0" ToolTip="Открыть параметры системы (Accent)">
                        <Path Data="{StaticResource GeoSettings}" Fill="White" Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource BtnSuccess}" Width="36" Height="36" Padding="0" Margin="0,0,8,0" ToolTip="Запустить воспроизведение (Success)">
                        <Path Data="{StaticResource GeoPlay}" Fill="White" Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource BtnError}" Width="36" Height="36" Padding="0" Margin="0,0,8,0" ToolTip="Удалить выбранный элемент (Error)">
                        <Path Data="{StaticResource GeoDelete}" Fill="White" Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource BtnInfo}" Width="36" Height="36" Padding="0" Margin="0,0,8,0" ToolTip="Найти в документе (Info)">
                        <Path Data="{StaticResource GeoSearch}" Fill="White" Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                </StackPanel>

                <!-- 4. Switches & Toggles in all states and colors -->
                <Border Height="1" Background="{StaticResource BorderBrushDefault}" Margin="0,6,0,16"/>
                <TextBlock Text="Переключатели (ToggleButton, CheckBox во всех состояниях и RadioButton):" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Column 1: Modern ToggleSwitches (States & Palette Colors) -->
                    <Border Grid.Column="0" Background="#162032" CornerRadius="6" Padding="12" Margin="0,0,8,0" BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Переключатели (ToggleButton):" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <ToggleButton Style="{StaticResource ModernToggleSwitch}" IsChecked="True" Content="Активный переключатель (ON)" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3"/>
                            <ToggleButton Style="{StaticResource ModernToggleSwitch}" IsChecked="False" Content="Неактивный переключатель (OFF)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3"/>
                            <ToggleButton Style="{StaticResource ModernToggleSwitch}" IsChecked="True" IsEnabled="False" Content="Заблокирован (Disabled ON)" Foreground="{StaticResource TextMutedBrush}" Margin="0,3"/>
                            <ToggleButton Style="{StaticResource ModernToggleSwitch}" IsChecked="False" IsEnabled="False" Content="Заблокирован (Disabled OFF)" Foreground="{StaticResource TextMutedBrush}" Margin="0,3"/>
                            
                            <Border Height="1" Background="{StaticResource BorderBrushDefault}" Margin="0,6,0,6"/>
                            <TextBlock Text="Цвета переключателей (п. 1.2.2):" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <ToggleButton Style="{StaticResource ModernToggleSwitchAccent}" IsChecked="True" Content="Accent Переключатель" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3"/>
                            <ToggleButton Style="{StaticResource ModernToggleSwitchSuccess}" IsChecked="True" Content="Success Переключатель" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3"/>
                            <ToggleButton Style="{StaticResource ModernToggleSwitchError}" IsChecked="True" Content="Error Переключатель" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3"/>
                            <ToggleButton Style="{StaticResource ModernToggleSwitchInfo}" IsChecked="True" Content="Info Переключатель" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3"/>
                        </StackPanel>
                    </Border>

                    <!-- Column 2: CheckBoxes (All States & Colors) -->
                    <Border Grid.Column="1" Background="#162032" CornerRadius="6" Padding="12" Margin="0,0,8,0" BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Флажки (CheckBox состояния):" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <CheckBox Style="{StaticResource ModernCheckBox}" IsChecked="True" Content="Отмечен (Checked)"/>
                            <CheckBox Style="{StaticResource ModernCheckBox}" IsChecked="False" Content="Не отмечен (Unchecked)"/>
                            <CheckBox Style="{StaticResource ModernCheckBox}" IsChecked="{x:Null}" IsThreeState="True" Content="Неопределенный (Indeterminate)"/>
                            <CheckBox Style="{StaticResource ModernCheckBox}" IsChecked="True" IsEnabled="False" Content="Отключен отмеченный"/>
                            <CheckBox Style="{StaticResource ModernCheckBox}" IsChecked="False" IsEnabled="False" Content="Отключен неотмеченный"/>
                            
                            <Border Height="1" Background="{StaticResource BorderBrushDefault}" Margin="0,6,0,6"/>
                            <TextBlock Text="Цвета флажков (п. 1.2.2):" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <CheckBox Style="{StaticResource ModernCheckBoxAccent}" IsChecked="True" Content="Accent Флажок"/>
                            <CheckBox Style="{StaticResource ModernCheckBoxSuccess}" IsChecked="True" Content="Success Флажок"/>
                            <CheckBox Style="{StaticResource ModernCheckBoxError}" IsChecked="True" Content="Error Флажок"/>
                            <CheckBox Style="{StaticResource ModernCheckBoxInfo}" IsChecked="True" Content="Info Флажок"/>
                        </StackPanel>
                    </Border>

                    <!-- Column 3: RadioButtons (Grouped & Colored) -->
                    <Border Grid.Column="2" Background="#162032" CornerRadius="6" Padding="12" BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Переключатели (RadioButtons):" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <RadioButton Style="{StaticResource ModernRadioButton}" GroupName="OptionGroup1" IsChecked="True" Content="Основной режим (Primary)"/>
                            <RadioButton Style="{StaticResource ModernRadioButtonAccent}" GroupName="OptionGroup1" Content="Приоритетный режим (Accent)"/>
                            <RadioButton Style="{StaticResource ModernRadioButtonSuccess}" GroupName="OptionGroup1" Content="Фоновый процесс (Success)"/>
                            <RadioButton Style="{StaticResource ModernRadioButtonError}" GroupName="OptionGroup1" Content="Критический аудит (Error)"/>
                            <RadioButton Style="{StaticResource ModernRadioButtonInfo}" GroupName="OptionGroup1" Content="Информационный лог (Info)"/>
                            <RadioButton Style="{StaticResource ModernRadioButton}" GroupName="OptionGroup1" IsEnabled="False" Content="Недоступная опция (Disabled)"/>

                            <Border Height="1" Background="{StaticResource BorderBrushDefault}" Margin="0,8,0,6"/>
                            <TextBlock Text="Независимая подгруппа Radio:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <RadioButton Style="{StaticResource ModernRadioButtonSuccess}" GroupName="OptionGroup2" IsChecked="True" Content="Активный статус"/>
                            <RadioButton Style="{StaticResource ModernRadioButton}" GroupName="OptionGroup2" Content="Спящий статус"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Expander>

        <!-- ========================================================================= -->
        <!-- EXPANDER 2: 1.3.1.2. ПОЛЯ ВВОДА И СПИСКИ                                   -->
        <!-- ========================================================================= -->
        <Expander IsExpanded="True" Style="{StaticResource SectionExpanderStyle}" Padding="16">
            <Expander.Header>
                <Grid Margin="4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#311B92" CornerRadius="6" Width="36" Height="36" Margin="0,0,12,0">
                        <Path Data="{StaticResource GeoSearch}" Fill="{StaticResource AccentBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="1.3.1.2. Поля ввода и списки" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="TextBox, PasswordBox, ComboBox, ListBox с поддержкой выбора и RichTextBox с FlowDocument" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="#1E293B" BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="1" CornerRadius="12" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock Text="Ввод и списки" FontSize="11" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Expander.Header>

            <StackPanel Margin="4,8">
                <!-- Row 1: TextBoxes & PasswordBox -->
                <TextBlock Text="Поля ввода (TextBox и PasswordBox во всех ключевых состояниях):" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Standard, Placeholder, ReadOnly, Success -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Обычное текстовое поле (TextBox):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Text="Пример редактируемого текста в WPF" Margin="0,0,0,12"/>

                        <TextBlock Text="Текстовое поле с подсказкой (Placeholder / Watermark):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <TextBox x:Name="SearchInputBox" Style="{StaticResource ModernTextBox}"/>
                            <TextBlock Text="🔍 Введите поисковый запрос или фильтр..." Foreground="{StaticResource TextMutedBrush}"
                                       Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchInputBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <TextBlock Text="Поле только для чтения (ReadOnly):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBox}" IsReadOnly="True" Text="SYS-RECORD-#904128-READONLY" Margin="0,0,0,12"/>

                        <TextBlock Text="Поле с индикацией успешной валидации (Success State):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <TextBox Style="{StaticResource ModernTextBox}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1.5" Foreground="{StaticResource SuccessBrush}" Text="admin.profile@corp.local"/>
                            <Path Data="{StaticResource GeoCheck}" Fill="{StaticResource SuccessBrush}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                    </StackPanel>

                    <!-- Right Column: Disabled, PasswordBox (Enabled/Disabled), Validated Error -->
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Отключенное поле (Disabled):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBox}" IsEnabled="False" Text="Системное поле заблокировано для ввода" Margin="0,0,0,12"/>

                        <TextBlock Text="Поле ввода пароля (PasswordBox со стилизацией):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <PasswordBox Style="{StaticResource ModernPasswordBox}" Password="SuperSecretMasterKey2026!"/>
                            <Path Data="{StaticResource GeoLock}" Fill="{StaticResource TextMutedBrush}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>

                        <TextBlock Text="Отключенное поле пароля (Disabled PasswordBox):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <PasswordBox Style="{StaticResource ModernPasswordBox}" IsEnabled="False" Password="InactiveSecureVaultPin" Margin="0,0,0,12"/>

                        <TextBlock Text="Поле с индикацией ошибки (Error State):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <TextBox Style="{StaticResource ModernTextBox}" BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1.5" Foreground="{StaticResource ErrorBrush}" Text="invalid_user_format@@domain"/>
                            <Path Data="{StaticResource GeoAlertCircle}" Fill="{StaticResource ErrorBrush}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Row 2: ComboBox & ListBox -->
                <Border Height="1" Background="{StaticResource BorderBrushDefault}" Margin="0,4,0,16"/>
                <TextBlock Text="Списки выбора (ComboBox и ListBox):" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: ComboBox Examples -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Выпадающий список статусов (ComboBox по всем цветам палитры 1.2.2):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <ComboBox Style="{StaticResource ModernComboBox}" SelectedIndex="0" Margin="0,0,0,14">
                            <ComboBoxItem Content="🔵 Основной поток обработки (Primary)"/>
                            <ComboBoxItem Content="🟣 Акцентная приоритетная задача (Accent)"/>
                            <ComboBoxItem Content="🟢 Успешно синхронизировано (Success)"/>
                            <ComboBoxItem Content="🔴 Ошибка выполнения скрипта (Error)"/>
                            <ComboBoxItem Content="🟡 Информационное уведомление (Info)"/>
                        </ComboBox>

                        <TextBlock Text="Выбор роли пользователя (ComboBox):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <ComboBox Style="{StaticResource ModernComboBox}" SelectedIndex="1" Margin="0,0,0,14">
                            <ComboBoxItem Content="Администратор системы (Полный доступ)"/>
                            <ComboBoxItem Content="Ведущий разработчик WPF"/>
                            <ComboBoxItem Content="Инженер по качеству (QA)"/>
                            <ComboBoxItem Content="Гостевой наблюдатель (Только чтение)"/>
                        </ComboBox>

                        <TextBlock Text="Отключенный выпадающий список (Disabled ComboBox):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <ComboBox Style="{StaticResource ModernComboBox}" IsEnabled="False" SelectedIndex="0" Margin="0,0,0,14">
                            <ComboBoxItem Content="Заблокированный режим конфигурации"/>
                        </ComboBox>

                        <Border Background="#162032" CornerRadius="6" Padding="12" BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="💡 Свойства ComboBox в WPF:" FontWeight="Bold" FontSize="12" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Поддерживает двусторонний биндинг SelectedItem, фильтрацию через ICollectionView, виртуализацию элементов и кастомные DataTemplate." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right: Rich ListBox with 5 Theme Badges -->
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Элементы списка ListBox (с поддержкой выбора и бейджами по всем 5 цветам):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <ListBox Style="{StaticResource ModernListBox}" SelectedIndex="0" Height="250">
                            <!-- Item 1: Primary -->
                            <ListBoxItem>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#1E3A8A" CornerRadius="4" Width="28" Height="28" Margin="0,0,10,0">
                                        <Path Data="{StaticResource GeoCheck}" Fill="{StaticResource PrimaryBrush}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="AuthController.cs" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Модуль аутентификации и токенов" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#1E3A8A" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="Primary" FontSize="10" Foreground="White" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </ListBoxItem>

                            <!-- Item 2: Accent -->
                            <ListBoxItem>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#311B92" CornerRadius="4" Width="28" Height="28" Margin="0,0,10,0">
                                        <Path Data="{StaticResource GeoSettings}" Fill="{StaticResource AccentBrush}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="ThemeManager.cs" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Служба управления палитрой стилей" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#311B92" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="Accent" FontSize="10" Foreground="White" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </ListBoxItem>

                            <!-- Item 3: Success -->
                            <ListBoxItem>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#064E3B" CornerRadius="4" Width="28" Height="28" Margin="0,0,10,0">
                                        <Path Data="{StaticResource GeoPlay}" Fill="{StaticResource SuccessBrush}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="NetworkService.cs" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Шлюз фоновой синхронизации данных" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#064E3B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="Success" FontSize="10" Foreground="White" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </ListBoxItem>

                            <!-- Item 4: Error -->
                            <ListBoxItem>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#450A0A" CornerRadius="4" Width="28" Height="28" Margin="0,0,10,0">
                                        <Path Data="{StaticResource GeoAlertCircle}" Fill="{StaticResource ErrorBrush}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="CrashDiagnostics.cs" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Обработчик исключений и сбоев" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#450A0A" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="Error" FontSize="10" Foreground="White" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </ListBoxItem>

                            <!-- Item 5: Info -->
                            <ListBoxItem>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#083344" CornerRadius="4" Width="28" Height="28" Margin="0,0,10,0">
                                        <Path Data="{StaticResource GeoInfoCircle}" Fill="{StaticResource InfoBrush}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="TelemetryMetrics.cs" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Служба сбора системных метрик и логов" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#083344" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="Info" FontSize="10" Foreground="White" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </ListBoxItem>
                        </ListBox>
                    </StackPanel>
                </Grid>

                <!-- Row 3: RichTextBox with FlowDocument -->
                <Border Height="1" Background="{StaticResource BorderBrushDefault}" Margin="0,4,0,16"/>
                <TextBlock Text="Форматированный текстовый редактор (RichTextBox с FlowDocument):" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                
                <RichTextBox Background="#0F172A" Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="1"
                             Padding="14" FontSize="13" FontFamily="Segoe UI" IsReadOnly="False"
                             MinHeight="160">
                    <FlowDocument PagePadding="0">
                        <Paragraph Margin="0,0,0,8" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}">
                            Документ WPF FlowDocument с поддержкой многокомпонентного форматирования
                        </Paragraph>
                        <Paragraph Margin="0,0,0,8" LineHeight="20" Foreground="{StaticResource TextPrimaryBrush}">
                            Компонент <Bold>RichTextBox</Bold> в WPF реализует потоковое форматирование содержимого. В нем доступны: 
                            <Bold>полужирный шрифт для выделения сути</Bold>, 
                            <Italic>курсивное начертание для цитат и определений</Italic>, а также 
                            <Underline>подчеркнутые фрагменты текста</Underline>.
                        </Paragraph>
                        <Paragraph Margin="0,0,0,8">
                            Цветовое отображение ключевых статусов дизайн-системы (п. 1.2.2):
                            <Span Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"> [Primary: #3B82F6] </Span>
                            <Span Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"> [Accent: #8B5CF6] </Span>
                            <Span Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"> [Success: #10B981] </Span>
                            <Span Foreground="{StaticResource ErrorBrush}" FontWeight="SemiBold"> [Error: #EF4444] </Span>
                            <Span Foreground="{StaticResource InfoBrush}" FontWeight="SemiBold"> [Info: #06B6D4] </Span>
                        </Paragraph>
                        <Paragraph Margin="0,0,0,4" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}">
                            Маркированный список возможностей FlowDocument:
                        </Paragraph>
                        <List MarkerStyle="Disc" Margin="16,0,0,0">
                            <ListItem>
                                <Paragraph Margin="0,2" Foreground="{StaticResource TextPrimaryBrush}">Векторный рендеринг шрифтов без искажений на дисплеях с высоким DPI</Paragraph>
                            </ListItem>
                            <ListItem>
                                <Paragraph Margin="0,2" Foreground="{StaticResource TextPrimaryBrush}">Встраивание элементов UIElement (кнопки, индикаторы, изображения) прямо в текст</Paragraph>
                            </ListItem>
                            <ListItem>
                                <Paragraph Margin="0,2" Foreground="{StaticResource TextPrimaryBrush}">Сохранение и загрузка в форматах XAML, RTF и обычном тексте</Paragraph>
                            </ListItem>
                        </List>
                    </FlowDocument>
                </RichTextBox>
            </StackPanel>
        </Expander>

        <!-- ========================================================================= -->
        <!-- EXPANDER 3: 1.3.1.3. TEXTBLOCK И LABEL (ТИПОГРАФИКА)                       -->
        <!-- ========================================================================= -->
        <Expander IsExpanded="True" Style="{StaticResource SectionExpanderStyle}" Padding="16">
            <Expander.Header>
                <Grid Margin="4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#065F46" CornerRadius="6" Width="36" Height="36" Margin="0,0,12,0">
                        <TextBlock Text="Tt" Foreground="{StaticResource SuccessBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="1.3.1.3. TextBlock и Label (Типографика)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Заголовки 1-3, обычный текст и подпись для TextBlock и Label, привязка мнемоник Target" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="#1E293B" BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="1" CornerRadius="12" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock Text="Типографика" FontSize="11" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Expander.Header>

            <StackPanel Margin="4,8">
                <!-- Part A: Comparison Grid - TextBlock vs Label Typography Hierarchy -->
                <TextBlock Text="Иерархия шрифтов и стили типографики: Заголовки 1-3, обычный текст и подпись:" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- TextBlock Column -->
                    <Border Grid.Column="0" Background="#162032" CornerRadius="8" Padding="14" Margin="0,0,8,0" BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="1">
                        <StackPanel>
                            <Border Background="#1E3A8A" CornerRadius="4" Padding="8,4" Margin="0,0,0,12" HorizontalAlignment="Left">
                                <TextBlock Text="Элемент: TextBlock (Потоковый вывод текста)" FontWeight="Bold" FontSize="12" Foreground="White"/>
                            </Border>

                            <!-- Heading 1 -->
                            <Border BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Заголовок 1 (H1, 24pt, Bold)" FontSize="24pt" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="TextBlock: 24 pt • Bold" FontSize="11" Foreground="{StaticResource PrimaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Heading 2 -->
                            <Border BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Заголовок 2 (H2, 20pt, SemiBold)" FontSize="20pt" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="TextBlock: 20 pt • SemiBold" FontSize="11" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Heading 3 -->
                            <Border BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Заголовок 3 (H3, 16pt, Medium)" FontSize="16pt" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="TextBlock: 16 pt • Medium" FontSize="11" Foreground="{StaticResource SuccessBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Body Text -->
                            <Border BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Обычный текст (Body text, 14pt, Regular)" FontSize="14pt" FontWeight="Normal" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Легковесный рендеринг без накладных расходов ContentControl." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Caption -->
                            <StackPanel>
                                <TextBlock Text="Подпись (Caption / Small text, 11pt, Muted)" FontSize="11pt" Foreground="{StaticResource TextMutedBrush}" FontWeight="Normal"/>
                                <TextBlock Text="TextBlock: 11 pt • Muted" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Label Column -->
                    <Border Grid.Column="1" Background="#162032" CornerRadius="8" Padding="14" Margin="8,0,0,0" BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="1">
                        <StackPanel>
                            <Border Background="#311B92" CornerRadius="4" Padding="8,4" Margin="0,0,0,12" HorizontalAlignment="Left">
                                <TextBlock Text="Элемент: Label (ContentControl с поддержкой Target)" FontWeight="Bold" FontSize="12" Foreground="White"/>
                            </Border>

                            <!-- Label Heading 1 -->
                            <Border BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <Label Content="Заголовок 1 (H1, 24pt, Bold)" FontSize="24pt" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Padding="0"/>
                                    <TextBlock Text="Label: 24 pt • Bold" FontSize="11" Foreground="{StaticResource PrimaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Label Heading 2 -->
                            <Border BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <Label Content="Заголовок 2 (H2, 20pt, SemiBold)" FontSize="20pt" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Padding="0"/>
                                    <TextBlock Text="Label: 20 pt • SemiBold" FontSize="11" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Label Heading 3 -->
                            <Border BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <Label Content="Заголовок 3 (H3, 16pt, Medium)" FontSize="16pt" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" Padding="0"/>
                                    <TextBlock Text="Label: 16 pt • Medium" FontSize="11" Foreground="{StaticResource SuccessBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Label Body Text -->
                            <Border BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <Label Content="Обычный текст (Body text, 14pt, Regular)" FontSize="14pt" FontWeight="Normal" Foreground="{StaticResource TextPrimaryBrush}" Padding="0"/>
                                    <TextBlock Text="ContentControl с поддержкой шаблонов, рамки и отступов." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Label Caption -->
                            <StackPanel>
                                <Label Content="Подпись (Caption / Small text, 11pt, Muted)" FontSize="11pt" Foreground="{StaticResource TextMutedBrush}" FontWeight="Normal" Padding="0"/>
                                <TextBlock Text="Label: 11 pt • Muted" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Part B: Labels with AccessKey (Alt+Hotkey) and Target -->
                <TextBlock Text="Элементы Label (с поддержкой мнемоник AccessKey и связи Target):" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,10"/>
                
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#162032" CornerRadius="6" Padding="12" Margin="0,0,8,0" BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="1">
                        <StackPanel>
                            <!-- Label pointing to Target TextBox -->
                            <Label Content="_Имя пользователя (нажмите Alt+И):" Target="{Binding ElementName=DemoUsernameBox}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" Padding="0,0,0,4"/>
                            <TextBox x:Name="DemoUsernameBox" Style="{StaticResource ModernTextBox}" Text="alexander.sozontov" Margin="0,0,0,8"/>
                            <TextBlock Text="Нажатие комбинации Alt+И автоматически переводит фокус в данное поле ввода." FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="#162032" CornerRadius="6" Padding="12" Margin="8,0,0,0" BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="1">
                        <StackPanel>
                            <!-- Label pointing to Target PasswordBox -->
                            <Label Content="_Пароль учетной записи (нажмите Alt+П):" Target="{Binding ElementName=DemoTargetPwdBox}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" Padding="0,0,0,4"/>
                            <PasswordBox x:Name="DemoTargetPwdBox" Style="{StaticResource ModernPasswordBox}" Password="UserSecurePass123" Margin="0,0,0,8"/>
                            <TextBlock Text="Нажатие комбинации Alt+П переводит клавиатурный фокус ввода в поле пароля." FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Part C: Label Badges across all 5 Theme Colors from 1.2.2 -->
                <TextBlock Text="Стилизованные Label-бейджи (для каждого цветового отображения из п. 1.2.2):" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,10"/>
                <WrapPanel>
                    <Border Background="#1E3A8A" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,10,8">
                        <Label Content="Primary: Основной статус" Foreground="White" FontWeight="SemiBold" Padding="0"/>
                    </Border>
                    <Border Background="#311B92" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,10,8">
                        <Label Content="Accent: Приоритетный акцент" Foreground="White" FontWeight="SemiBold" Padding="0"/>
                    </Border>
                    <Border Background="#064E3B" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,10,8">
                        <Label Content="Success: Успешное состояние" Foreground="White" FontWeight="SemiBold" Padding="0"/>
                    </Border>
                    <Border Background="#450A0A" BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,10,8">
                        <Label Content="Error: Критическое оповещение" Foreground="White" FontWeight="SemiBold" Padding="0"/>
                    </Border>
                    <Border Background="#083344" BorderBrush="{StaticResource InfoBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,10,8">
                        <Label Content="Info: Информационный маркер" Foreground="White" FontWeight="SemiBold" Padding="0"/>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Expander>

        <!-- ========================================================================= -->
        <!-- EXPANDER 4: 1.3.1.7. ВСПЛЫВАЮЩИЕ ПОДСКАЗКИ (TOOLTIP)                       -->
        <!-- ========================================================================= -->
        <Expander IsExpanded="True" Style="{StaticResource SectionExpanderStyle}" Padding="16">
            <Expander.Header>
                <Grid Margin="4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#083344" CornerRadius="6" Width="36" Height="36" Margin="0,0,12,0">
                        <Path Data="{StaticResource GeoInfoCircle}" Fill="{StaticResource InfoBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="1.3.1.7. Всплывающие подсказки (ToolTip)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Стандартный, кастомный с иконкой/описанием и статусные ToolTip (Успех, Инфо, Предупреждение, Ошибка)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="#1E293B" BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="1" CornerRadius="12" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock Text="ToolTips" FontSize="11" Foreground="{StaticResource InfoBrush}" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Expander.Header>

            <StackPanel Margin="4,8">
                <TextBlock Text="Наведите курсор мыши на любой из элементов ниже для отображения всплывающей подсказки:" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                <!-- Row 1: Simple & Rich Custom ToolTips -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ToolTip 1: Simple String -->
                    <Border Grid.Column="0" Background="#162032" CornerRadius="8" Padding="14" Margin="0,0,8,0" BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="1. Стандартная строковая подсказка" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="Стандартный текстовый ToolTip без сложной разметки (атрибут ToolTip='...')." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            
                            <Button Style="{StaticResource BtnOutlinedPrimary}" Content="Наведите курсор сюда (Стандартный ToolTip)" Padding="12,8"
                                    ToolTip="Это стандартная всплывающая подсказка с простым текстом."/>
                        </StackPanel>
                    </Border>

                    <!-- ToolTip 2: Custom Rich ToolTip -->
                    <Border Grid.Column="1" Background="#162032" CornerRadius="8" Padding="14" Margin="8,0,0,0" BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="2. Кастомный форматированный ToolTip" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="Богатая верстка с векторной иконкой, заголовком, описанием и хоткеем." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            
                            <Button Style="{StaticResource BtnPrimary}" Content="Облачная синхронизация (Кастомный ToolTip)">
                                <Button.ToolTip>
                                    <ToolTip Background="#1E293B" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1.5" Padding="12">
                                        <StackPanel MaxWidth="300">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <Border Background="#1E3A8A" CornerRadius="4" Width="26" Height="26" Margin="0,0,8,0">
                                                    <Path Data="{StaticResource GeoCloud}" Fill="{StaticResource PrimaryBrush}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Облачная синхронизация" FontWeight="Bold" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="Автоматическое резервное копирование состояния приложения в защищенное облачное хранилище. Все сессии зашифрованы." 
                                                       TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8"/>
                                            <Border Background="#0F172A" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left">
                                                <TextBlock Text="Горячая клавиша: Ctrl + Shift + S" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                            </Border>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Row 2: Status-Based ToolTips (Success, Info, Warning, Error) -->
                <TextBlock Text="3. Статусные подсказки по ключевым индикаторам системы (п. 1.2.2):" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,10"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Success ToolTip -->
                    <Border Grid.Column="0" Background="#162032" CornerRadius="8" Padding="12" Margin="0,0,6,0" BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Успех (Success)" FontWeight="Bold" FontSize="12" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,8"/>
                            <Button Style="{StaticResource BtnSuccess}" Content="Готовность" Padding="10,8">
                                <Button.ToolTip>
                                    <ToolTip Background="#1E293B" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1.5" Padding="10">
                                        <StackPanel MaxWidth="240">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Path Data="{StaticResource GeoCheck}" Fill="{StaticResource SuccessBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Операция успешна" FontWeight="Bold" FontSize="12" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="Все контрольные проверки интерфейса завершены без замечаний." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Info ToolTip -->
                    <Border Grid.Column="1" Background="#162032" CornerRadius="8" Padding="12" Margin="3,0,3,0" BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Инфо (Info)" FontWeight="Bold" FontSize="12" Foreground="{StaticResource InfoBrush}" Margin="0,0,0,8"/>
                            <Button Style="{StaticResource BtnInfo}" Content="Справка" Padding="10,8">
                                <Button.ToolTip>
                                    <ToolTip Background="#1E293B" BorderBrush="{StaticResource InfoBrush}" BorderThickness="1.5" Padding="10">
                                        <StackPanel MaxWidth="240">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Path Data="{StaticResource GeoInfoCircle}" Fill="{StaticResource InfoBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Инфо о системе" FontWeight="Bold" FontSize="12" Foreground="{StaticResource InfoBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="Платформа: WPF / .NET 8 / C#. Двустороннее связывание данных." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Warning ToolTip -->
                    <Border Grid.Column="2" Background="#162032" CornerRadius="8" Padding="12" Margin="3,0,3,0" BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Внимание (Warning)" FontWeight="Bold" FontSize="12" Foreground="{StaticResource WarningBrush}" Margin="0,0,0,8"/>
                            <Button Style="{StaticResource BtnOutlinedInfo}" BorderBrush="{StaticResource WarningBrush}" Foreground="{StaticResource WarningBrush}" Content="Предупреждение" Padding="10,8">
                                <Button.ToolTip>
                                    <ToolTip Background="#1E293B" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1.5" Padding="10">
                                        <StackPanel MaxWidth="240">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Path Data="{StaticResource GeoAlertTriangle}" Fill="{StaticResource WarningBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Предупреждение" FontWeight="Bold" FontSize="12" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="Изменение гарнитуры шрифта потребует перезапуска окна приложения." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Error ToolTip -->
                    <Border Grid.Column="3" Background="#162032" CornerRadius="8" Padding="12" Margin="6,0,0,0" BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Ошибка (Error)" FontWeight="Bold" FontSize="12" Foreground="{StaticResource ErrorBrush}" Margin="0,0,0,8"/>
                            <Button Style="{StaticResource BtnError}" Content="Сбой сети" Padding="10,8">
                                <Button.ToolTip>
                                    <ToolTip Background="#1E293B" BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1.5" Padding="10">
                                        <StackPanel MaxWidth="240">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Path Data="{StaticResource GeoAlertCircle}" Fill="{StaticResource ErrorBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Сетевой сбой" FontWeight="Bold" FontSize="12" Foreground="{StaticResource ErrorBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="Таймаут обращения к удаленному RPC-серверу (код 0x80072EE2)." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Expander>

    </StackPanel>
</UserControl>
