            <!-- ============================================================== -->
            <!-- ИНСПЕКТОР ВЫБРАННОГО ОТТЕНКА (LIVE SHADE INSPECTOR)            -->
            <!-- ============================================================== -->
            <Border Background="#151F30" BorderBrush="#3B82F6" BorderThickness="1.5" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Large Selected Color Preview -->
                        <Border Grid.Column="0" Width="130" Height="100" Background="{Binding SelectedColor.Brush}" CornerRadius="8" BorderBrush="#475569" BorderThickness="1.5" Margin="0,0,18,0" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock Text="{Binding SelectedColor.Shade}" Foreground="{Binding SelectedColor.TextBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border Background="#25000000" CornerRadius="0,0,7,7" VerticalAlignment="Bottom" Height="22">
                                    <TextBlock Text="{Binding SelectedColor.HexCode}" Foreground="{Binding SelectedColor.TextBrush}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Selected Color Details -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Инспектор выбранного оттенка:" Foreground="#94A3B8" FontSize="13" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding SelectedColor.Name}" Foreground="#F8FAFC" FontWeight="Bold" FontSize="15"/>
                            </StackPanel>

                            <WrapPanel Margin="0,2,0,6">
                                <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,8,4">
                                    <TextBlock Text="{Binding SelectedColor.HexCode, StringFormat='HEX: {0}'}" FontFamily="Consolas" Foreground="#60A5FA" FontWeight="Bold" FontSize="12"/>
                                </Border>
                                <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,8,4">
                                    <TextBlock Text="{Binding SelectedColor.RgbCode, StringFormat='RGB: {0}'}" FontFamily="Consolas" Foreground="#CBD5E1" FontSize="12"/>
                                </Border>
                                <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,8,4">
                                    <TextBlock Text="{Binding SelectedColor.Category, StringFormat='Группа: {0}'}" Foreground="#C4B5FD" FontSize="12"/>
                                </Border>
                            </WrapPanel>

                            <TextBlock Text="{Binding SelectedColor.Description, StringFormat='Роль в дизайне: {0}'}" Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        </StackPanel>

                        <!-- Copy and Action Buttons -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Vertical">
                            <Button Style="{StaticResource ActionButtonStyle}" Content="Копировать HEX" Margin="0,0,0,6" Width="140" Click="CopyHex_Click"/>
                            <Button Style="{StaticResource ActionButtonStyle}" Content="Копировать RGB" Width="140" Click="CopyRgb_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Interactive Contrast & Component Preview -->
                    <Border Grid.Row="1" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Пример UI кнопки:" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Border Background="{Binding SelectedColor.Brush}" CornerRadius="4" Padding="10,4">
                                    <TextBlock Text="Кнопка действия" Foreground="{Binding SelectedColor.TextBrush}" FontWeight="SemiBold" FontSize="11"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Тест читаемости текста:" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Border Background="{Binding SelectedColor.Brush}" CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                                    <TextBlock Text="Белый текст (White)" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="{Binding SelectedColor.Brush}" CornerRadius="4" Padding="10,4">
                                    <TextBlock Text="Тёмный текст (Slate)" Foreground="#0F172A" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>

                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="WPF Color Swatch Inspector v1.2" Foreground="#475569" FontSize="11" FontStyle="Italic"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
