<UserControl x:Class="WpfLabApp.Views.ColorPaletteTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="1400" d:DesignWidth="1100">

    <UserControl.Resources>
        <!-- Modern GroupBox Style -->
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Background="#151F30"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        CornerRadius="7,7,0,0"
                                        Padding="14,10">
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                                </Border>
                                <Border Grid.Row="1" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Content"/>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sub TabItem Style (Segmented Buttons) -->
        <Style x:Key="SubTabItemStyle" TargetType="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#334155"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#60A5FA"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#243247"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Styled DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#2A384C"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="RowBackground" Value="#172234"/>
            <Setter Property="AlternatingRowBackground" Value="#121B2A"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1E293B"/>
                        <Setter Property="Foreground" Value="#CBD5E1"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="BorderBrush" Value="#334155"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2E2563EB"/>
                                <Setter Property="Foreground" Value="#93C5FD"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#24334A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1E3A8A"/>
                                <Setter Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Mini Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#334155"/>
                                <Setter Property="BorderBrush" Value="#60A5FA"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#2563EB"/>
                                <Setter Property="BorderBrush" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Main Scrollable Container -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16" Orientation="Vertical">

            <!-- ============================================================== -->
            <!-- 1.2.1. ВЫВОД НАИМЕНОВАНИЯ ТЕКУЩЕЙ ТЕМЫ ПРИЛОЖЕНИЯ              -->
            <!-- ============================================================== -->
            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="20,16" Margin="0,0,0,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                            <Border Background="#3B82F6" Width="8" Height="22" CornerRadius="4" Margin="0,0,10,0"/>
                            <TextBlock Text="1.2.1. Наименование текущей темы приложения" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <Border Background="#1E1B4B" BorderBrush="#8B5CF6" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="12,0,0,0">
                                <TextBlock Text="Активная дизайн-система" Foreground="#A78BFA" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding CurrentThemeName}" FontSize="15" FontWeight="SemiBold" Foreground="#60A5FA" Margin="18,0,0,4"/>
                        <TextBlock Text="{Binding ThemeDescription}" FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap" Margin="18,0,0,0" MaxWidth="820"/>
                    </StackPanel>

                    <!-- Theme Specs / Badges -->
                    <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Orientation="Vertical" HorizontalAlignment="Right">
                        <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Режим:" Foreground="#64748B" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Slate Dark (WCAG AA)" Foreground="#10B981" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Палитра:" Foreground="#64748B" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="5 категорий • 50 оттенков" Foreground="#F8FAFC" FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Real-Time Notification Toast Bar -->
                    <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#0F172A" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,12,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="ℹ" Foreground="#3B82F6" FontWeight="Bold" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding StatusNotification}" Foreground="#E2E8F0" FontSize="12"/>
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right" Text="Буфер обмена активен" Foreground="#64748B" FontSize="11" FontStyle="Italic"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ============================================================== -->
            <!-- 1.2.2. СГРУППИРОВАННЫЕ ЦВЕТА С ЦВЕТОВЫМ ОТОБРАЖЕНИЕМ           -->
            <!-- ============================================================== -->
            <StackPanel Orientation="Vertical" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Border Background="#8B5CF6" Width="8" Height="22" CornerRadius="4" Margin="0,0,10,0"/>
                    <TextBlock Text="1.2.2. Ключевые сгруппированные цвета интерфейса" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="(Основной, акцентный и индикаторные цвета)" FontSize="14" Foreground="#94A3B8" Margin="8,2,0,0"/>
                </StackPanel>

                <!-- Grid for Primary and Accent (2 Columns) -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- GroupBox 1: Primary Color -->
                    <GroupBox Grid.Column="0" Margin="0,0,8,12">
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#3B82F6" Width="10" Height="10" CornerRadius="5" Margin="0,0,8,0"/>
                                <TextBlock Text="Основной цвет (Primary)" FontWeight="Bold" FontSize="14" Foreground="#F8FAFC"/>
                                <TextBlock Text="• Синий Royal" FontSize="12" Foreground="#93C5FD" Margin="6,1,0,0"/>
                            </StackPanel>
                        </GroupBox.Header>

                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Color Preview Swatch -->
                            <Border Grid.Column="0" Height="105" Background="#3B82F6" CornerRadius="8" BorderBrush="#60A5FA" BorderThickness="1.5" VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock Text="#3B82F6" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border Background="#20000000" CornerRadius="0,0,7,7" VerticalAlignment="Bottom" Height="22">
                                        <TextBlock Text="Primary 500" Foreground="White" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Color Details -->
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Primary (Синий Royal)" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC"/>
                                
                                <WrapPanel Margin="0,6,0,6">
                                    <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                        <TextBlock Text="HEX: #3B82F6" FontFamily="Consolas" FontSize="12" Foreground="#60A5FA"/>
                                    </Border>
                                    <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                        <TextBlock Text="RGB: 59, 130, 246" FontFamily="Consolas" FontSize="12" Foreground="#94A3B8"/>
                                    </Border>
                                    <Border Background="#1E3A8A" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                        <TextBlock Text="Главный CTA" FontSize="11" Foreground="#DBEAFE"/>
                                    </Border>
                                </WrapPanel>

                                <TextBlock Text="Роль: Основной цвет приложения. Применяется для активных вкладок, главных кнопок действий, рамок фокуса ввода и брендовых заголовков." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource ActionButtonStyle}" Content="Копировать HEX" Margin="0,0,6,0" Click="CopyHex_Click" CommandParameter="#3B82F6"/>
                                    <Button Style="{StaticResource ActionButtonStyle}" Content="Копировать RGB" Click="CopyRgb_Click" CommandParameter="rgb(59, 130, 246)"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- GroupBox 2: Accent Color -->
                    <GroupBox Grid.Column="1" Margin="8,0,0,12">
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#8B5CF6" Width="10" Height="10" CornerRadius="5" Margin="0,0,8,0"/>
                                <TextBlock Text="Акцентный цвет (Accent)" FontWeight="Bold" FontSize="14" Foreground="#F8FAFC"/>
                                <TextBlock Text="• Фиолетовый Indigo/Violet" FontSize="12" Foreground="#C4B5FD" Margin="6,1,0,0"/>
                            </StackPanel>
                        </GroupBox.Header>

                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Color Preview Swatch -->
                            <Border Grid.Column="0" Height="105" Background="#8B5CF6" CornerRadius="8" BorderBrush="#A78BFA" BorderThickness="1.5" VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock Text="#8B5CF6" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border Background="#20000000" CornerRadius="0,0,7,7" VerticalAlignment="Bottom" Height="22">
                                        <TextBlock Text="Accent 500" Foreground="White" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Color Details -->
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Accent (Фиолетовый Indigo/Violet)" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC"/>
                                
                                <WrapPanel Margin="0,6,0,6">
                                    <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                        <TextBlock Text="HEX: #8B5CF6" FontFamily="Consolas" FontSize="12" Foreground="#A78BFA"/>
                                    </Border>
                                    <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                        <TextBlock Text="RGB: 139, 92, 246" FontFamily="Consolas" FontSize="12" Foreground="#94A3B8"/>
                                    </Border>
                                    <Border Background="#4C1D95" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                        <TextBlock Text="Акценты &amp; Теги" FontSize="11" Foreground="#EDE9FE"/>
                                    </Border>
                                </WrapPanel>

                                <TextBlock Text="Роль: Акцентный цвет для вторичных интерактивных элементов, бейджей категорий, переключателей, декоративных градиентов и тегов." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource ActionButtonStyle}" Content="Копировать HEX" Margin="0,0,6,0" Click="CopyHex_Click" CommandParameter="#8B5CF6"/>
                                    <Button Style="{StaticResource ActionButtonStyle}" Content="Копировать RGB" Click="CopyRgb_Click" CommandParameter="rgb(139, 92, 246)"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>

                <!-- GroupBox 3: Indicator Colors (Success, Error, Info) -->
                <GroupBox Margin="0,0,0,16">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                <Border Background="#10B981" Width="8" Height="8" CornerRadius="4" Margin="0,0,3,0"/>
                                <Border Background="#EF4444" Width="8" Height="8" CornerRadius="4" Margin="0,0,3,0"/>
                                <Border Background="#06B6D4" Width="8" Height="8" CornerRadius="4"/>
                            </StackPanel>
                            <TextBlock Text="Индикаторные цвета состояния (Indicator Colors)" FontWeight="Bold" FontSize="14" Foreground="#F8FAFC"/>
                            <TextBlock Text="• Успех (Success), Ошибка (Error), Информация (Info)" FontSize="12" Foreground="#94A3B8" Margin="8,1,0,0"/>
                        </StackPanel>
                    </GroupBox.Header>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Success -->
                        <Border Grid.Column="0" Background="#151E2E" BorderBrush="#10B981" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                            <StackPanel Orientation="Vertical">
                                <Border Height="64" Background="#10B981" CornerRadius="6" BorderBrush="#34D399" BorderThickness="1" Margin="0,0,0,10">
                                    <Grid>
                                        <TextBlock Text="#10B981" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Text="Success 500" Foreground="#D1FAE5" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,4"/>
                                    </Grid>
                                </Border>

                                <TextBlock Text="Успех (Success)" FontSize="15" FontWeight="Bold" Foreground="#10B981"/>
                                <TextBlock Text="Изумрудный Green" FontSize="12" Foreground="#6EE7B7" Margin="0,1,0,6"/>

                                <WrapPanel Margin="0,0,0,8">
                                    <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                        <TextBlock Text="HEX: #10B981" FontFamily="Consolas" FontSize="11" Foreground="#34D399"/>
                                    </Border>
                                    <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,0,4">
                                        <TextBlock Text="RGB: 16, 185, 129" FontFamily="Consolas" FontSize="11" Foreground="#94A3B8"/>
                                    </Border>
                                </WrapPanel>

                                <TextBlock Text="Роль: Подтверждение действий, валидные поля формы, положительный статус выполнения и бейджи готовности." FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,10" MinHeight="48"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource ActionButtonStyle}" Content="HEX" Margin="0,0,6,0" Click="CopyHex_Click" CommandParameter="#10B981"/>
                                    <Button Style="{StaticResource ActionButtonStyle}" Content="RGB" Click="CopyRgb_Click" CommandParameter="rgb(16, 185, 129)"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Error -->
                        <Border Grid.Column="1" Background="#151E2E" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="12" Margin="4,0,4,0">
                            <StackPanel Orientation="Vertical">
                                <Border Height="64" Background="#EF4444" CornerRadius="6" BorderBrush="#F87171" BorderThickness="1" Margin="0,0,0,10">
                                    <Grid>
                                        <TextBlock Text="#EF4444" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Text="Error 500" Foreground="#FEE2E2" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,4"/>
                                    </Grid>
                                </Border>

                                <TextBlock Text="Ошибка (Error)" FontSize="15" FontWeight="Bold" Foreground="#EF4444"/>
                                <TextBlock Text="Красный Rose" FontSize="12" Foreground="#FCA5A5" Margin="0,1,0,6"/>

                                <WrapPanel Margin="0,0,0,8">
                                    <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                        <TextBlock Text="HEX: #EF4444" FontFamily="Consolas" FontSize="11" Foreground="#F87171"/>
                                    </Border>
                                    <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,0,4">
                                        <TextBlock Text="RGB: 239, 68, 68" FontFamily="Consolas" FontSize="11" Foreground="#94A3B8"/>
                                    </Border>
                                </WrapPanel>

                                <TextBlock Text="Роль: Критические предупреждения, ошибки валидации, деструктивные действия (удаление) и аварийные алерты." FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,10" MinHeight="48"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource ActionButtonStyle}" Content="HEX" Margin="0,0,6,0" Click="CopyHex_Click" CommandParameter="#EF4444"/>
                                    <Button Style="{StaticResource ActionButtonStyle}" Content="RGB" Click="CopyRgb_Click" CommandParameter="rgb(239, 68, 68)"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Info -->
                        <Border Grid.Column="2" Background="#151E2E" BorderBrush="#06B6D4" BorderThickness="1" CornerRadius="8" Padding="12" Margin="8,0,0,0">
                            <StackPanel Orientation="Vertical">
                                <Border Height="64" Background="#06B6D4" CornerRadius="6" BorderBrush="#22D3EE" BorderThickness="1" Margin="0,0,0,10">
                                    <Grid>
                                        <TextBlock Text="#06B6D4" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Text="Info 500" Foreground="#CFFAFE" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,4"/>
                                    </Grid>
                                </Border>

                                <TextBlock Text="Информация (Info)" FontSize="15" FontWeight="Bold" Foreground="#06B6D4"/>
